// get_inspection_certificate - tier T1, side effect none
// Generated by mcp-architect. Owner: Quality digital product team
permit(
  principal is AgentCore::OAuthUser,
  action == AgentCore::Action::"QualityCertificatesTools___get_inspection_certificate",
  resource == AgentCore::Gateway::"${GatewayArn}"
)
when {
  principal.hasTag("scp") &&
  principal.getTag("scp") like "*quality/read*"
  && principal.hasTag("legal_entity")
  && context.input.item_number >= 1 && context.input.item_number <= 9999
};
