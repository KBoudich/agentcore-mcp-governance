<mxfile host="app.diagrams.net" agent="mcp-architect drawio_kit" version="24.7.17" type="device"><diagram id="01-aws-reference-architecture" name="Enterprise MCP platform — AWS reference architecture (target state)"><mxGraphModel dx="1820" dy="1260" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1260" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="page" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=none;locked=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1820" height="1260" as="geometry"/></mxCell><mxCell id="title" value="Enterprise MCP platform — AWS reference architecture (target state)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=26;fontColor=#142B49;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1740" height="44" as="geometry"/></mxCell><mxCell id="subtitle" value="Per-domain AgentCore Gateways in a dedicated platform account; tools run in domain accounts; evidence lands in the log-archive account. Numbers follow one tool call." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#142B49;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1740" height="30" as="geometry"/></mxCell><mxCell id="footer" value="Conceptual target state. Region, IdP and connectivity choices are assumptions to confirm (see proposal §7 gates). Icons: AWS Architecture Icons via draw.io." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#5A6C86;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="1214" width="1740" height="30" as="geometry"/></mxCell><mxCell id="ext" value="Workforce &amp; clients" style="rounded=1;ar