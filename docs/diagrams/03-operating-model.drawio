<mxfile host="app.diagrams.net" agent="mcp-architect drawio_kit" version="24.7.17" type="device"><diagram id="03-operating-model" name="Federated MCP governance — central paved road, domain ownership"><mxGraphModel dx="1700" dy="980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="980" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Federated MCP governance — central paved road, domain ownership" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=26;fontColor=#142B49;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="44" as="geometry"/></mxCell><mxCell id="subtitle" value="Governance effort follows potential harm (risk tier), not the number of tools. Authors never approve their own authority increase." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#142B49;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1620" height="30" as="geometry"/></mxCell><mxCell id="footer" value="Roles map to existing governance bodies where they exist (Architecture board, CISO office, Data governance, Legal/Export control)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#5A6C86;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="934" width="1620" height="30" as="geometry"/></mxCell><mxCell id="da" value="&lt;b&gt;MCP Design Authority&lt;/b&gt; (monthly + async)&lt;br&gt;Enterprise Architecture (chair) · CISO office · Data governance · Legal / export control · Works-council liaison when HR data is involved&lt;br&gt;&lt;i&gt;Owns: standards, risk-tier model, exceptions with expiry&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF2FA;strokeColor=#3B5BA9;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#142B49;fontStyle=0;dashed=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="520" y="120" width="660" height="150" as="geometry"/></mxCell><mxCell id="plat" value="&lt;b&gt;MCP Platform team&lt;/b&gt; (Cloud CoE)&lt;br&gt;• Gateways, Policy engines, Identity providers per domain&lt;br&gt;• Paved road: &lt;b&gt;mcp-architect plugin&lt;/b&gt;, CDK constructs, Cedar CI, tool registry&lt;br&gt;• Observability, cost allocation, quota management&lt;br&gt;• Break-glass forbid runbooks, DR drills" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#142B49;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#142B49;fontStyle=0;dashed=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="80" y="340" width="700" height="220" as="geometry"/></mxCell><mxCell id="dom" value="&lt;b&gt;Domain product teams&lt;/b&gt; (Supply chain · Quality · Maintenance · Finance · HR · Engineering)&lt;br&gt;• Own tool purpose, schema, adapter and backend checks&lt;br&gt;• Entity/plant isolation tests, idempotency, approvals&lt;br&gt;• Runbooks and on-call for their tools&lt;br&gt;• Retire tools they no longer own" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#142B49;fontStyle=0;dashed=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="920" y="340" width="700" height="220" as="geometry"/></mxCell><mxCell id="risk" value="&lt;b&gt;Business risk owners&lt;/b&gt;&lt;br&gt;Approve T2/T3 tools and their limits (amount, plant, shift). Hold human-approval authority — not infrastructure rights." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4DB;strokeColor=#B7791F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#142B49;fontStyle=0;dashed=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="80" y="640" width="470" height="170" as="geometry"/></mxCell><mxCell id="soc" value="&lt;b&gt;SOC / CSIRT&lt;/b&gt;&lt;br&gt;Monitors policy-denial storms, catalog drift, unusual extraction. Executes targeted forbid + backend containment." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C7254E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#142B49;fontStyle=0;dashed=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="615" y="640" width="470" height="170" as="geometry"/></mxCell><mxCell id="users" value="&lt;b&gt;Consumers&lt;/b&gt; (agent builders, Copilot/Claude users)&lt;br&gt;Request tools through the registry; see only tools Cedar permits at discovery." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD1D6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#142B49;fontStyle=0;dashed=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="1150" y="640" width="470" height="170" as="geometry"/></mxCell><mxCell id="e_da_plat" value="standards" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#142B49;strokeWidth=1.6;dashed=0;fontFamily=Helvetica;fontSize=11;fontColor=#142B49;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="da" target="plat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_da_dom" value="standards" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#142B49;strokeWidth=1.6;dashed=0;fontFamily=Helvetica;fontSize=11;fontColor=#142B49;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="da" target="dom"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_dom_plat" value="tool onboarding PR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#B7791F;strokeWidth=1.6;dashed=0;fontFamily=Helvetica;fontSize=11;fontColor=#142B49;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.4;exitDx=0;exitDy=0;entryX=1;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="dom" target="plat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_plat_dom" value="policy + gateway release" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#142B49;strokeWidth=1.6;dashed=0;fontFamily=Helvetica;fontSize=11;fontColor=#142B49;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="plat" target="dom"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_risk_plat" value="T2/T3 sign-off" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#B7791F;strokeWidth=1.6;dashed=0;fontFamily=Helvetica;fontSize=11;fontColor=#142B49;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="risk" target="plat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_soc_plat" value="containment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#C7254E;strokeWidth=1.6;dashed=0;fontFamily=Helvetica;fontSize=11;fontColor=#142B49;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="soc" target="plat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_users_dom" value="requests" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#142B49;strokeWidth=1.6;dashed=0;fontFamily=Helvetica;fontSize=11;fontColor=#142B49;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="users" target="dom"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sod" value="Separation of duties enforced in IAM, not on paper: tool author ≠ policy approver ≠ releaser (automation identity) · platform admins hold no business approval rights" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#142B49;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#142B49;fontStyle=1;dashed=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="80" y="850" width="1540" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
