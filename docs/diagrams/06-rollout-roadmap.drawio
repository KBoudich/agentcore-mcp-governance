<mxfile host="app.diagrams.net" agent="mcp-architect drawio_kit" version="24.7.17" type="device"><diagram id="06-rollout-roadmap" name="Rollout roadmap — authority expands only after evidence"><mxGraphModel dx="1800" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="820" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="page" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=none;locked=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1800" height="820" as="geometry"/></mxCell><mxCell id="title" value="Rollout roadmap — authority expands only after evidence" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=26;fontColor=#142B49;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1720" height="44" as="geometry"/></mxCell><mxCell id="subtitle" value="Indicative timeline from November 2026. Each phase exits through a Design Authority gate; any phase can drop into containment." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#142B49;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1720" height="30" as="geometry"/></mxCell><mxCell id="footer" value="Use-case examples are illustrative candidates for business domains; final selection belongs to domain owners." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#5A6C86;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="774" width="1720" height="30" as="geometry"/></mxCell><mxCell id="ph0" value="&lt;b&gt;Phase 0 · Foundations&lt;/b&gt;&lt;br&gt;Nov–Dec 2026" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF2FA;strokeColor=#3B5BA9;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#142B49;fontStyle=0;dashed=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="300" height="70" as="geometry"/></mxCell><mxCell id="ph0_w" value="Accounts &amp; SCPs · IdP claims (entity, plant) · Region gate decision · platform CDK · plugin adoption · registry" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD1D6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#142B49;fontStyle=0;dashed=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="215" width="300" height="150" as="geometry"/></mxCell><mxCell id="ph1" value="&lt;b&gt;Phase 1 · Read-only pilot (T0/T1)&lt;/b&gt;&lt;br&gt;Jan–Mar 2027" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#142B49;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#142B49;fontStyle=0;dashed=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="390" y="130" width="300" height="70" as="geometry"/></mxCell><mxCell id="ph1_w" value="Quality: inspection-certificate lookup · Supply chain: order &amp; delivery status · 50 pilot users · LOG_ONLY → ENFORCE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD1D6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#142B49;fontStyle=0;dashed=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="390" y="215" width="300" height="150" as="geometry"/></mxCell><mxCell id="e_ph0_ph1" value="Gate 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#142B49;strokeWidth=2;dashed=0;fontFamily=Helvetica;fontSize=11;fontColor=#142B49;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ph0" target="ph1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ph2" value="&lt;b&gt;Phase 2 · Reversible writes (T2)&lt;/b&gt;&lt;br&gt;Apr–Jun 2027" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4DB;strokeColor=#B7791F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#142B49;fontStyle=0;dashed=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="740" y="130" width="300" height="70" as="geometry"/></mxCell><mxCell id="ph2_w" value="Draft non-conformance report · draft maintenance notification · idempotency + compensation proven" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD1D6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#142B49;fontStyle=0;dashed=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="740" y="215" width="300" height="150" as="geometry"/></mxCell><mxCell id="e_ph1_ph2" value="Gate 2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#142B49;strokeWidth=2;dashed=0;fontFamily=Helvetica;fontSize=11;fontColor=#142B49;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ph1" target="ph2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ph3" value="&lt;b&gt;Phase 3 · Consequential actions (T3)&lt;/b&gt;&lt;br&gt;Jul–Sep 2027" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C7254E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#142B49;fontStyle=0;dashed=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1090" y="130" width="300" height="70" as="geometry"/></mxCell><mxCell id="ph3_w" value="Quality-hold release / PO approval with bound human approval, limits per plant &amp; role, reconciliation" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD1D6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#142B49;fontStyle=0;dashed=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="1090" y="215" width="300" height="150" as="geometry"/></mxCell><mxCell id="e_ph2_ph3" value="Gate 3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#142B49;strokeWidth=2;dashed=0;fontFamily=Helvetica;fontSize=11;fontColor=#142B49;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ph2" target="ph3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ph4" value="&lt;b&gt;Phase 4 · Scale&lt;/b&gt;&lt;br&gt;Q4 2027 →" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#142B49;fontStyle=0;dashed=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1440" y="130" width="300" height="70" as="geometry"/></mxCell><mxCell id="ph4_w" value="More domains &amp; entities · further Regions as Policy coverage allows · partitioned gateway for export-controlled data" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD1D6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#142B49;fontStyle=0;dashed=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="1440" y="215" width="300" height="150" as="geometry"/></mxCell><mxCell id="e_ph3_ph4" value="Gate 4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#142B49;strokeWidth=2;dashed=0;fontFamily=Helvetica;fontSize=11;fontColor=#142B49;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ph3" target="ph4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="contain" value="&lt;b&gt;Containment path (any phase)&lt;/b&gt;: targeted Cedar forbid → backend kill-switch → reconcile in-flight writes → root cause → re-enter by repeating the affected acceptance gates.  Rate limits = consumption control, never the safety net." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C7254E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#142B49;fontStyle=0;dashed=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="1720" height="70" as="geometry"/></mxCell><mxCell id="k1" value="&lt;b&gt;Adoption&lt;/b&gt;&lt;br&gt;Active agent users · tools reused across ≥2 consumers" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#CBD1D6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#142B49;fontStyle=0;dashed=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="410" height="120" as="geometry"/></mxCell><mxCell id="k2" value="&lt;b&gt;Safety&lt;/b&gt;&lt;br&gt;0 cross-entity reads in tests &amp; prod · 100% T3 calls with approval record" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#CBD1D6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#142B49;fontStyle=0;dashed=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="477" y="560" width="410" height="120" as="geometry"/></mxCell><mxCell id="k3" value="&lt;b&gt;Delivery&lt;/b&gt;&lt;br&gt;Lead time requirements → prod per tool (target ≤ 4 weeks for T1)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#CBD1D6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#142B49;fontStyle=0;dashed=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="914" y="560" width="410" height="120" as="geometry"/></mxCell><mxCell id="k4" value="&lt;b&gt;Cost&lt;/b&gt;&lt;br&gt;Cost per completed business task, not per gateway call" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#CBD1D6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#142B49;fontStyle=0;dashed=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1351" y="560" width="410" height="120" as="geometry"/></mxCell><mxCell id="kpi_title" value="Success measures reviewed at each gate" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#142B49;fontStyle=1;" vertex="1" parent="1"><mxGeometry 