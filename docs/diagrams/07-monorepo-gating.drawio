<mxfile host="app.diagrams.net" agent="mcp-architect drawio_kit" version="24.7.17" type="device"><diagram id="07-monorepo-gating" name="Where the skills run — one monorepo, the same gates on the laptop and in the pipeline"><mxGraphModel dx="1800" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="860" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="page" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=none;locked=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1800" height="860" as="geometry"/></mxCell><mxCell id="title" value="Where the skills run — one monorepo, the same gates on the laptop and in the pipeline" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=26;fontColor=#142B49;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1720" height="44" as="geometry"/></mxCell><mxCell id="subtitle" value="Application code, infrastructure and the governance skills live in one repository; every change passes the same deterministic gate before it can merge or deploy." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#142B49;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1720" height="30" as="geometry"/></mxCell><mxCell id="footer" value="The deterministic gate decides; AI review advises. Works with GitHub Actions or GitLab CI, and with Claude Code, OpenAI Codex or GitHub Copilot." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#5A6C86;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="814" width="1720" height="30" as="geometry"/></mxCell><mxCell id="ws" value="1 · Developer workstation" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#CBD1D6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#142B49;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="400" height="640" as="geometry"/></mxCell><mxCell id="dev" value="&lt;b&gt;Engineer + coding agent&lt;/b&gt;&lt;br&gt;Claude Code · OpenAI Codex · GitHub Copilot" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#142B49;strokeColor=#142B49;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#FFFFFF;fontStyle=0;dashed=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="340" height="80" as="geometry"/></mxCell><mxCell id="sk" value="&lt;b&gt;Skills installed in the repo&lt;/b&gt;&lt;br&gt;.agents/skills · .claude/skills&lt;br&gt;(install.py, from the pinned pack)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#142B49;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#142B49;fontStyle=0;dashed=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="340" height="90" as="geometry"/></mxCell><mxCell id="design" value="&lt;b&gt;New or changed server&lt;/b&gt;&lt;br&gt;design-mcp: spec → ADR → Cedar → CDK" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#142B49;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#142B49;fontStyle=0;dashed=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="410" width="340" height="80" as="geometry"/></mxCell><mxCell id="lgate" value="&lt;b&gt;Before every push&lt;/b&gt;&lt;br&gt;mcp-repo-compliance skill&lt;br&gt;→ check_repo.py on changed servers" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4DB;strokeColor=#B7791F;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#142B49;fontStyle=0;dashed=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="340" height="90" as="geometry"/></mxCell><mxCell id="wsnote" value="Same scripts as CI, so a red gate is found on the laptop, not in review." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#5A6C86;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="630" width="340" height="110" as="geometry"/></mxCell><mxCell id="mono" value="2 · Central MCP monorepo" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#CBD1D6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#142B49;" vertex="1" parent="1"><mxGeometry x="540" y="130" width="560" height="640" as="geometry"/></mxCell><mxCell id="srv" value="&lt;b&gt;servers/&amp;lt;name&amp;gt;/&lt;/b&gt; — one directory per MCP server&lt;br&gt;mcp-spec.yaml · governance ADR&lt;br&gt;application: tool adapter + interceptor code&lt;br&gt;infrastructure: CDK stack · Cedar policies · tests" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#142B49;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#142B49;fontStyle=0;dashed=0;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="570" y="180" width="500" height="150" as="geometry"/></mxCell><mxCell id="srv2" value="servers/&amp;lt;another&amp;gt;/ · servers/&amp;lt;…&amp;gt;/" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#142B49;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#142B49;fontStyle=0;dashed=1;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="570" y="345" width="500" height="46" as="geometry"/></mxCell><mxCell id="vendor" value="&lt;b&gt;vendor/agentcore-mcp-governance&lt;/b&gt; (pinned submodule)&lt;br&gt;skills + gate scripts, one version for everyone" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF2FA;strokeColor=#3B5BA9;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#142B49;fontStyle=0;dashed=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="570" y="415" width="500" height="80" as="geometry"/></mxCell><mxCell id="cat" value="&lt;b&gt;CATALOG.md&lt;/b&gt; (generated)&lt;br&gt;every server and tool · owners · tiers · check status" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#142B49;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#142B49;fontStyle=0;dashed=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="570" y="515" width="500" height="70" as="geometry"/></mxCell><mxCell id="own" value="&lt;b&gt;CODEOWNERS + branch protection&lt;/b&gt;&lt;br&gt;domain team per server · platform team for governance files" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#142B49;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#142B49;fontStyle=0;dashed=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="570" y="605" width="500" height="70" as="geometry"/></mxCell><mxCell id="ci" value="3 · CI on every change — GitHub Actions or GitLab CI" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#CBD1D6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#142B49;" vertex="1" parent="1"><mxGeometry x="1140" y="130" width="620" height="420" as="geometry"/></mxCell><mxCell id="gate" value="&lt;b&gt;Governance gate — required, no AI&lt;/b&gt;&lt;br&gt;check_repo.py on changed servers: spec rules · ADR present · one permit + break-glass forbid per tool · no broad or orphan permit · catalogue current" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#142B49;fontStyle=0;dashed=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1170" y="180" width="560" height="120" as="geometry"/></mxCell><mxCell id="ai" value="&lt;b&gt;AI review — optional, advisory&lt;/b&gt;&lt;br&gt;mcp-governance-review skill run by Claude, Codex or Copilot → comment on the pull / merge request" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#142B49;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#142B49;fontStyle=0;dashed=1;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1170" y="320" width="560" height="90" as="geometry"/></mxCell><mxCell id="merge" value="&lt;b&gt;Merge only when the gate is green&lt;/b&gt;&lt;br&gt;and the CODEOWNERS have approved" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#142B49;strokeColor=#142B49;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#FFFFFF;fontStyle=0;dashed=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1170" y="430" width="560" height="80" as="geometry"/></mxCell><mxCell id="dl" value="4 · Delivery" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#CBD1D6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#142B49;" vertex="1" parent="1"><mxGeometry x="1140" y="590" width="620" height="180" as="geometry"/></mxCell><mxCell id="deploy" value="&lt;b&gt;CDK pipeline&lt;/b&gt;&lt;br&gt;dev → stage (Policy LOG_ONLY) → prod (ENFORCE)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#142B49;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#142B49;fontStyle=0;dashed=0;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1170" y="640" width="400" height="90" as="geometry"/></mxCell><mxCell id="agw" value="AgentCore Gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=0;aspect=fixed;fillColor=#01A88D;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="1630" y="648" width="56" height="56" as="geometry"/></mxCell><mxCell id="e_lgate_srv" value="PR / MR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#142B49;strokeWidth=2.2;dashed=0;fontFamily=Helvetica;fontSize=11;fontColor=#142B49;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="lgate" target="srv"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="565"/><mxPoint x="470" y="300"/></Array></mxGeometry></mxCell><mxCell id="e_srv_gate" value="every change" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#142B49;strokeWidth=2.2;dashed=0;fontFamily=Helvetica;fontSize=11;fontColor=#142B49;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="srv" target="gate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_vendor_sk" value="install.py" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#3B5BA9;strokeWidth=1.6;dashed=1;fontFamily=Helvetica;fontSize=11;fontColor=#142B49;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="vendor" target="sk"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="510" y="455"/><mxPoint x="510" y="335"/></Array></mxGeometry></mxCell><mxCell id="e_vendor_gate" value="same scripts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#3B5BA9;strokeWidth=1.6;dashed=1;fontFamily=Helvetica;fontSize=11;fontColor=#142B49;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="vendor" target="gate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_merge_deploy" value="green only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#2E7D32;strokeWidth=2.2;dashed=0;fontFamily=Helvetica;fontSize=11;fontColor=#142B49;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="merge" target="deploy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_deploy_agw" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#142B49;strokeWidth=1.6;dashed=0;fontFamily=Helvetica;fontSize=11;fontColor=#142B49;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="deploy" target="agw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_gate_dev" value="findings" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#C7254E;strokeWidth=1.6;dashed=1;fontFamily=Helvetica;fontSize=11;fontColor=#142B49;labelBackgroundColor=#FFFFFF;exitX=0.9;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gate" target="dev"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1674" y="110"/><mxPoint x="230" y="110"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
